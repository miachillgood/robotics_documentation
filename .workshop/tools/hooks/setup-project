# npx skills add canonical/copilot-collections --list
SKILLS=(
  "documentation-build"
  "documentation-diataxis"
  "documentation-review"
  "documentation-structure"
  "documentation-style"
  "documentation-verify"
)

# Disable npx skills telemetry
echo 'export DISABLE_TELEMETRY=1' >> ~/.profile

DISABLE_TELEMETRY=1 npx --yes skills add canonical/copilot-collections --yes --global -a opencode \
  --skill "${SKILLS[@]}"
